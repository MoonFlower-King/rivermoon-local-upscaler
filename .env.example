# RiverMoon AI Studio development environment example
#
# The app does not load this file automatically. Set the variables explicitly
# in the shell that launches Electron or a smoke-test script.
# Never put a real API Key in a committed file.

# Optional local runtime overrides.
RIVERMOON_COMFYUI_ROOT=
RIVERMOON_COMFYUI_URL=http://127.0.0.1:8188
RIVERMOON_USER_DATA_DIR=

# Development-only account injection. Leave blank in source control.
RIVERMOON_TEST_KEY=

# Paid video E2E. These are intentionally blank and must only be set in a
# private shell after the maintainer explicitly accepts the cost.
RIVERMOON_API_KEY=
RIVERMOON_PAID_VIDEO_E2E_CONFIRM=
RIVERMOON_PAID_VIDEO_E2E_MODE=text_to_video
RIVERMOON_PAID_VIDEO_E2E_MODEL=
RIVERMOON_PAID_VIDEO_E2E_PROMPT=
RIVERMOON_PAID_VIDEO_E2E_SOURCE_PATHS=
RIVERMOON_PAID_VIDEO_E2E_REFERENCE_TYPES=
RIVERMOON_PAID_VIDEO_E2E_OUTPUT_DIR=
RIVERMOON_PAID_VIDEO_E2E_DURATION=
RIVERMOON_PAID_VIDEO_E2E_ASPECT_RATIO=
RIVERMOON_PAID_VIDEO_E2E_RESOLUTION=
RIVERMOON_PAID_VIDEO_E2E_TIMEOUT_MS=900000
RIVERMOON_PAID_VIDEO_E2E_CONTRACT_TIMEOUT_MS=15000

# Public contract smoke-test overrides.
RIVERMOON_VIDEO_CONTRACT_URL=https://video.rivermoon7.com/v1/video/contract
RIVERMOON_VIDEO_CONTRACT_TIMEOUT_MS=15000

# Local release tooling.
RIVERMOON_7Z_PATH=
RIVERMOON_GITHUB_RELEASE_VOLUME_MB=1900
RIVERMOON_LAUNCH_SMOKE_TIMEOUT_MS=30000
RIVERMOON_LAUNCH_SMOKE_STABLE_MS=3000
