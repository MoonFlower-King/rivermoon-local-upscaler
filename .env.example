# RiverMoon 本地超分 —— 环境变量示例
# ──────────────────────────────────────────────────────────────
# 复制为本地 .env（.env 已被 .gitignore 忽略，不会入库）。
# 这些变量均为「可选的开发期覆盖项」，由进程环境读取（process.env）。
# 在 PowerShell 里临时生效示例： $env:RIVERMOON_COMFYUI_ROOT = "D:\ComfyUI"; npm run dev:electron
# 注意：打包后的正式版固定使用内置 runtime，仅 dev 环境读取下列开关。
# ──────────────────────────────────────────────────────────────

# 是否允许在「开发环境」复用一个外部已运行的 ComfyUI（1 = 允许，默认关闭）。
# 打包版忽略此项，永远使用内置 runtime，避免误连到用户机器上的其他工作流。
RIVERMOON_USE_EXTERNAL_COMFYUI=0

# 外部 ComfyUI 的地址（仅当上面为 1 时生效）。默认 http://127.0.0.1:8188
RIVERMOON_COMFYUI_URL=http://127.0.0.1:8188

# 自定义 ComfyUI runtime 根目录（覆盖默认的 resources/comfyui-runtime）。
# 仅当该目录存在时生效；用于本机已有一份 ComfyUI 时免去复制。
RIVERMOON_COMFYUI_ROOT=

# Windows 上若本机设置了 ELECTRON_RUN_AS_NODE=1 会导致 Electron 以纯 Node 启动。
# 开发运行请用 `npm run dev:electron`（脚本会自动清掉该变量）。
# ELECTRON_RUN_AS_NODE=
