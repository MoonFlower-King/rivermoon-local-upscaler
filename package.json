{
  "name": "rivermoon-local-upscaler",
  "version": "0.1.0",
  "private": true,
  "description": "RiverMoon 本地图片超分桌面应用",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron": "wait-on tcp:5173 && node scripts/dev-electron.cjs",
    "dev:electron": "concurrently -k \"npm:dev\" \"npm:electron\"",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win dir",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^42.5.2",
    "electron-builder": "^25.1.8",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.0.7",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.rivermoon.localupscaler",
    "productName": "RiverMoon 本地超分",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/comfyui-runtime",
        "to": "comfyui-runtime",
        "filter": [
          "**/*",
          "!custom_nodes/ComfyUI-DiffBIR/**",
          "!custom_nodes/ComfyUI_DiffBIR/**",
          "!custom_nodes/ComfyUI-SUPIR/**",
          "!models/diffbir/**",
          "!models/checkpoints/**",
          "!models/upscale_models/*.pth"
        ]
      },
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
