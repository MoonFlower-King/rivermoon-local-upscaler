{
  "name": "rivermoon-local-upscaler",
  "version": "0.2.0",
  "private": true,
  "description": "连接 rivermoon7.com 的 AI 生图、视频、GPT 对话与本地超分桌面应用",
  "license": "MIT",
  "author": "RiverMoon Contributors",
  "homepage": "https://github.com/MoonFlower-King/rivermoon-local-upscaler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonFlower-King/rivermoon-local-upscaler.git"
  },
  "bugs": {
    "url": "https://github.com/MoonFlower-King/rivermoon-local-upscaler/issues"
  },
  "keywords": [
    "electron",
    "ai-image-generation",
    "ai-video-generation",
    "image-upscaling",
    "comfyui",
    "cuda"
  ],
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron": "wait-on tcp:5173 && node scripts/dev-electron.cjs",
    "dev:electron": "concurrently -k \"npm:dev\" \"npm:electron\"",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win dir",
    "agent:responses-smoke": "node scripts/agent-responses-smoke.mjs",
    "image:contract-smoke": "npm run build && node scripts/image-contract-smoke.mjs",
    "video:contract-smoke": "npm run build && node scripts/video-contract-smoke.mjs",
    "video:paid-e2e": "npm run build && node scripts/video-paid-e2e.mjs",
    "video:paid-e2e:dry-run": "npm run build && node scripts/video-paid-e2e.mjs --dry-run",
    "release:launch-smoke": "node scripts/release-launch-smoke.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:github:assets": "node scripts/create-github-release-assets.mjs",
    "release:github:metadata": "node scripts/create-github-release-assets.mjs --metadata-only",
    "release:github:preflight": "node scripts/release-github-preflight.mjs",
    "release:github": "npm run release:verify && npm run release:github:assets && npm run release:github:preflight",
    "release:online-smoke": "npm run agent:responses-smoke && npm run image:contract-smoke && npm run video:contract-smoke",
    "release:verify": "npm run check && npm run dist:dir && npm run release:smoke && npm run release:launch-smoke",
    "repo:preflight": "node scripts/repo-preflight.mjs",
    "repo:preflight:strict": "node scripts/repo-preflight.mjs --strict",
    "check": "npm run repo:preflight && npm run format:check && npm run lint && npm test && npm run build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{mjs,cjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{mjs,cjs}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.rivermoon.localupscaler",
    "productName": "RiverMoon AI 创作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/comfyui-runtime",
        "to": "comfyui-runtime",
        "filter": [
          "**/*",
          "!custom_nodes/ComfyUI-DiffBIR/**",
          "!custom_nodes/ComfyUI_DiffBIR/**",
          "!custom_nodes/ComfyUI-SUPIR/**",
          "!models/diffbir/**",
          "!models/checkpoints/**",
          "!models/upscale_models/*.pth"
        ]
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "PRODUCT_DOCUMENT.md",
          "PRODUCT_REPORT_BILINGUAL.md",
          "USER_GUIDE_BILINGUAL.md",
          "BUILD_AND_RELEASE.md"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
